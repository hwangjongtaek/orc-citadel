# 원격지(운영) .env 템플릿 — 호스트의 리포 최상위 .env 에 복사 후 실값 주입.
#   cp .env.production.example .env && chmod 600 .env && vi .env
# 실 .env 는 gitignore (.env.*) — 커밋 금지. 로컬 개발 .env 와 값이 달라야 한다.

# --- docker-compose 인프라 스택 크리덴셜 (운영 값 — 추측 불가한 강도) ---
POSTGRES_USER=citadel
POSTGRES_DB=citadel
POSTGRES_PASSWORD=REPLACE_ME_strong_pg_password
MINIO_ROOT_USER=citadel
MINIO_ROOT_PASSWORD=REPLACE_ME_strong_minio_password_8chars_min
NEO4J_PASSWORD=REPLACE_ME_strong_neo4j_password_8chars

# --- LLM 프로바이더 config (design 07 §6.2 — scheduler 의 nightly_slo06 이 사용) ---
# LLM_PROVIDER = anthropic | openrouter | litellm
LLM_PROVIDER=litellm
LLM_MODEL=glm-4.7-flash
LLM_API_KEY=REPLACE_ME_llm_api_key
LLM_BASE_URL=https://platform-llm.datamaker.io
# 판정 completion 예산 — reasoning 모델(glm-4.7-flash)은 8192 권장 (미설정 시 2048).
LLM_MAX_TOKENS=8192

# --- viewer 외부 공개 여부 (운영 기본 loopback — SSH 터널로 접근 권장) ---
# SSH 터널 예: ssh -N -L 8791:127.0.0.1:8791 <host>  → 로컬 브라우저 :8791
# 0.0.0.0 으로 바꾸면 전 인터페이스 바인딩 (방화벽/보안 검토 후 결정)
VIEWER_BIND=127.0.0.1
