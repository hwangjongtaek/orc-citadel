# GitHub MCP (.mcp.json 의 github 서버가 이 토큰을 사용)
# 필요한 스코프: repo (repo 편집 포함). fine-grained PAT 이면 대상 repo 에 Read/Write 권한 부여.
# 발급: https://github.com/settings/tokens
GITHUB_TOKEN=ghp_your_token_here

# docker-compose 인프라 스택 크리덴셜 (로컬 전용 — 원하는 값으로 교체)
POSTGRES_USER=citadel
POSTGRES_PASSWORD=change_me
POSTGRES_DB=citadel
MINIO_ROOT_USER=citadel
MINIO_ROOT_PASSWORD=change_me_8chars_min
NEO4J_PASSWORD=change_me_8chars

# LLM 프로바이더 config (design 07 §6.2 — Anthopic·OpenRouter·LiteLLM 세팅)
# LLM_PROVIDER = anthropic | openrouter | litellm   (기본 anthropic)
# LLM_MODEL    = 모델명 (openrouter 예: "anthropic/claude-sonnet", litellm proxy 모델)
# LLM_API_KEY  = 프로바이더 API 키
# LLM_BASE_URL = openrouter: https://openrouter.ai/api/v1 / litellm proxy 엔드포인트
LLM_PROVIDER=anthropic
LLM_MODEL=claude-opus-4-8
# LLM_API_KEY=sk-...
# LLM_BASE_URL=https://openrouter.ai/api/v1
